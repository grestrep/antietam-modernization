; Export table of the smav2 ddraw.dll.
; Same export names and ordinals as Windows' ddraw.dll, so any caller finds what it expects.
;   Proxy_*  implemented by us (smav2_ddraw.cpp)
;   Fwd_*    naked jump stubs that forward to the system ddraw.dll (FWD macro in smav2_ddraw.cpp)
; DllCanUnloadNow/DllGetClassObject are COM entry points and must not carry ordinals (PRIVATE).
LIBRARY ddraw
EXPORTS
    AcquireDDThreadLock         = Fwd_AcquireDDThreadLock          @1
    CompleteCreateSysmemSurface = Fwd_CompleteCreateSysmemSurface  @2
    D3DParseUnknownCommand      = Fwd_D3DParseUnknownCommand       @3
    DDGetAttachedSurfaceLcl     = Fwd_DDGetAttachedSurfaceLcl      @4
    DDInternalLock              = Fwd_DDInternalLock               @5
    DDInternalUnlock            = Fwd_DDInternalUnlock             @6
    DSoundHelp                  = Fwd_DSoundHelp                   @7
    DirectDrawCreate            = Proxy_DirectDrawCreate           @8
    DirectDrawCreateClipper     = Fwd_DirectDrawCreateClipper      @9
    DirectDrawCreateEx          = Fwd_DirectDrawCreateEx           @10
    DirectDrawEnumerateA        = Fwd_DirectDrawEnumerateA         @11
    DirectDrawEnumerateExA      = Fwd_DirectDrawEnumerateExA       @12
    DirectDrawEnumerateExW      = Fwd_DirectDrawEnumerateExW       @13
    DirectDrawEnumerateW        = Fwd_DirectDrawEnumerateW         @14
    DllCanUnloadNow             = Fwd_DllCanUnloadNow              PRIVATE
    DllGetClassObject           = Fwd_DllGetClassObject            PRIVATE
    GetDDSurfaceLocal           = Fwd_GetDDSurfaceLocal            @17
    GetOLEThunkData             = Fwd_GetOLEThunkData              @18
    GetSurfaceFromDC            = Fwd_GetSurfaceFromDC             @19
    RegisterSpecialCase         = Fwd_RegisterSpecialCase          @20
    ReleaseDDThreadLock         = Fwd_ReleaseDDThreadLock          @21
    SetAppCompatData            = Fwd_SetAppCompatData             @22
